# free-ai-video 本地 .env 模板（复制为 .env 后填本机值；.env 绝不进 git）。
# 复制：Copy-Item .env.example .env

# === Agnes 鉴权 ===
# 单 Key（pwsh：$env:AGNES_API_KEY="sk-..."）
AGNES_API_KEY=
# 多 Key 逗号分隔；多免费 Key 默认不同账号、独立池（AGNES_API_KEYS 优先于 AGNES_API_KEY）
# AGNES_API_KEYS=sk-aaa...,sk-bbb...

# === 模型覆盖（三层优先级 CLI > ENV > config/models.yaml；文本留空=拒绝任务并指引配置） ===
AGNES_TEXT_MODEL=
# 文本高级参数（对应 config/models.yaml 的 text 节；显式设置才覆盖文件）
# FREEAI_TEXT_PROVIDER=agnes
# FREEAI_TEXT_PROTOCOL=openai
# FREEAI_TEXT_BASE_URL=http://127.0.0.1:11434/v1
# FREEAI_TEXT_TEMPERATURE=0.7
# FREEAI_TEXT_MAX_TOKENS=8192
# FREEAI_TEXT_TIMEOUT_S=120
AGNES_IMAGE_MODEL=agnes-image-2.5-flash
AGNES_VIDEO_MODEL=agnes-video-2.5-flash
TTS_PROVIDER=edge-tts
TTS_VOICE=zh-CN-XiaoxiaoNeural

# === KeyPool 加密（docs/03：Env 只存非秘密因子） ===
# 密钥库版本（可进 git 的默认值随代码发布）
FREEAI_KEY_VERSION=v1
# PBKDF2 salt，Base64（非秘密；模板可进，生产实例建议 per-激活覆盖）
FREEAI_KEYPOOL_SALT=RlJBQUktRGVmYXVsdC1TYWx0LXYx
# 后端长期派生密钥引用 ID（仅引用，非秘密本体；本体见下）
FREEAI_DERIVED_KEY_ID=
# DB 路径（默认 %APPDATA%/free-ai-video/keys_encrypted.db）
FREEAI_KEY_DB_PATH=%APPDATA%/free-ai-video/keys_encrypted.db
# 后端长期派生密钥本体：激活导入时由后端写入本机 .env，模板与 git 中只留空位
# FREEAI_DERIVED_KEY=

# === opencode 二进制选择（docs/05 §5.8；优先级 ENV > config/opencode.yaml） ===
# 模式：builtin（默认·内置 tools/opencode）/ system（系统 PATH）/ custom（须配下行路径）/ auto（内置→PATH 回退）
# OPENCODE_MODE=builtin
# 自定义二进制绝对路径（custom 模式必填；也可单独设置以覆盖任何模式）
# OPENCODE_BIN=C:\tools\opencode\opencode.exe

# === 安全红线（docs/03 §3.5） ===
# KEK、API Key 明文、TPM 机器码明文 绝不进 Env、.env、git、日志与崩溃转储。
# .env 只存 salt / 版本 / 引用 ID 等非秘密因子；KEK 只驻内存，用后清零。
# 换机直接拷贝 keys_encrypted.db 必然解密失败，须在新机重新激活后重新录入 Key。
